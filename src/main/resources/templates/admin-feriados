<!DOCTYPE html>
<html lang="pt-br" xmlns:th="http://www.thymeleaf.org"
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Gestão de Feriados</title>
    <link rel="stylesheet" th:href="@{/css/style.css}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>

    <header class="header">
        <div class="logo">Permanência CSUP - Feriados</div>
        <nav>
            <a th:href="@{/dashboard}">Voltar à Escala</a>
        </nav>
    </header>

    <div class="main-container" style="max-width: 900px; margin: 20px auto;">
        
        <div class="card" style="border-left: 5px solid #2ECC71; margin-bottom: 2rem;">
            <div class="card-header">
                <h2><i class="fas fa-calendar-plus"></i> Cadastrar Novo Feriado</h2>
            </div>
            <form th:action="@{/admin/feriados/salvar}" th:object="${feriado}" method="post" style="display: grid; grid-template-columns: 1fr 2fr auto; gap: 15px; align-items: end;">
                <div>
                    <label style="display: block; margin-bottom: 5px; font-weight: bold;">Data:</label>
                    <input type="date" th:field="*{data}" required style="width: 100%; padding: 8px; border-radius: 5px; border: 1px solid #ccc;">
                </div>
                <div>
                    <label style="display: block; margin-bottom: 5px; font-weight: bold;">Descrição (Ex: Dia do Exército):</label>
                    <input type="text" th:field="*{descricao}" placeholder="Nome do Feriado" required style="width: 100%; padding: 8px; border-radius: 5px; border: 1px solid #ccc;">
                </div>
                <button type="submit" class="btn-primary" style="padding: 10px 20px; background-color: #2ECC71; border: none; border-radius: 5px; color: white; cursor: pointer;">
                    <i class="fas fa-save"></i> Adicionar
                </button>
            </form>
        </div>

        <div class="card">
            <div class="card-header">
                <h2><i class="fas fa-calendar-alt"></i> Calendário de Folga Geral</h2>
                <p style="font-size: 0.85rem; color: #666; margin-top: 5px;">
                    Datas listadas abaixo impedem o giro automático da escala às 00:00.
                </p>
            </div>
            
            <table class="escala-table" style="width: 100%; margin-top: 1rem;">
                <thead>
                    <tr style="background-color: #f4f4f4;">
                        <th style="padding: 12px; text-align: left;">Data</th>
                        <th style="padding: 12px; text-align: left;">Evento / Descrição</th>
                        <th style="padding: 12px; text-align: center;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <tr th:each="f : ${feriados}">
                        <td style="padding: 12px; font-weight: bold;" th:text="${#temporals.format(f.data, 'dd/MM/yyyy')}">16/04/2026</td>
                        <td style="padding: 12px;" th:text="${f.descricao}">DIA DA BANDEIRA</td>
                        <td style="padding: 12px; text-align: center;">
                            <a th:href="@{/admin/feriados/excluir/{id}(id=${f.id})}" 
                               style="color: #e74c3c; text-decoration: none; font-size: 1.2rem;" 
                               title="Remover Feriado"
                               onclick="return confirm('Deseja remover este feriado? O sistema voltará a escalar nesta data.')">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </td>
                    </tr>
                    <tr th:if="${#lists.isEmpty(feriados)}">
                        <td colspan="3" style="text-align: center; padding: 20px; color: #999;">Nenhum feriado cadastrado. O sistema rodará todos os dias úteis.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <footer style="text-align: center; padding: 20px; color: #666;">
        <p>Sistema de Escala Militar - Módulo de Calendário Especial</p>
    </footer>

</body>
</html>